    },
    "The 00:30 departure belongs to the following calendar day of the selected service day. Hei Ling Chau services are not included." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans-HK" : {
          "stringUnit" : {
            "state" : "translated",
