    "Take the MTR to Tung Chung, then take NLB bus 23 from Tung Chung Tat Tung Road Bus Terminus to Ngong Ping." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乘搭港铁到东涌，再到东涌达东路巴士总站乘搭新大屿山巴士 23 号前往昂坪。"
          }
